PORT=4000
ENCRYPTION_KEY=your-secret-key-here

# Azure OpenAI (primary LLM provider)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure Cognitive Services (Speech-to-Text and Text-to-Speech)
AZURE_SPEECH_ENDPOINT_STT=https://your-region.stt.speech.microsoft.com
AZURE_SPEECH_ENDPOINT_TTS=https://your-region.tts.speech.microsoft.com
AZURE_SPEECH_API_KEY=your-speech-api-key-here
AZURE_SPEECH_REGION=your-region
